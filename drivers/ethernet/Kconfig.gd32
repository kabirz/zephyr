config ETH_GD32
	bool "GigaDevice GD32H7xx Ethernet driver"
	default y
	depends on DT_HAS_GD_GD32_ETH_ENABLED
	depends on NET_L2_ETHERNET
	select PINCTRL
	help
	  Enable the GigaDevice GD32H7xx Ethernet MAC driver (ENET0/ENET1).
	  Supports MII and RMII PHY interfaces (selected in SYSCFG) with the
	  PHY driven over MDIO; the PHY address is auto-detected unless the
	  `phy-address` property is set in devicetree.

config ETH_GD32_RX_THREAD_STACK_SIZE
	int "RX thread stack size"
	default 2048
	depends on ETH_GD32
	help
	  Stack size of the RX processing thread.

config ETH_GD32_RX_THREAD_PRIO
	int "RX thread priority"
	default 2
	depends on ETH_GD32
	help
	  Priority of the RX processing thread.

config ETH_GD32_RX_DESC_NUM
	int "Number of RX DMA descriptors"
	default 8
	range 2 32
	depends on ETH_GD32
	help
	  Size of the RX descriptor ring.  Each descriptor owns a dedicated
	  1536-byte buffer.  The descriptors live in the peripheral SRAM0
	  region, which the ENET DMA requires; with cache management enabled
	  the frame buffers can live in the default SRAM, allowing rings
	  larger than the 16 KB SRAM0 could hold.

config ETH_GD32_SRAM0_BUDGET
	int "SRAM0 budget for ENET descriptors and buffers (bytes)"
	default 16384
	depends on ETH_GD32
	help
	  Size of the peripheral SRAM0 region reserved for the ENET DMA
	  descriptor ring and frame buffers.  The build fails if the
	  configured ring does not fit.

config ETH_GD32_IRQ_TEST
	bool "GD32 ENET interrupt diagnosis hooks (bring-up only)"
	default n
	depends on ETH_GD32
	select SHELL
	help
	  Adds a `gdeth` shell command group that controls the DMA interrupt
	  enable register at runtime and counts the interrupt sources seen by
	  the ISR.  For bring-up debugging only; leave off in production.

config ETH_GD32_RX_BATCH
	int "RX frames processed per wakeup"
	default 8
	range 1 64
	depends on ETH_GD32
	help
	  Upper bound on frames the RX thread drains per wakeup before it
	  yields to lower-priority threads (the IP stack must run to keep
	  the TCP ACK path alive during receive bursts).
